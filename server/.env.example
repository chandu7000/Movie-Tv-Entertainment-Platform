PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/cineverse_db
TMDB_ACCESS_TOKEN=replace-with-your-tmdb-read-access-token
CLIENT_URL=http://localhost:3000
# Optional but recommended: enables automatic YouTube official-trailer fallback
# when TMDB has no usable Trailer/Teaser entry for a title.
YOUTUBE_API_KEY=replace-with-youtube-data-api-v3-key
